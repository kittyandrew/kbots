# Optional Sentry env vars for local runs. Unset SENTRY_DSN to disable reporting.
# SENTRY_DSN=https://...
SENTRY_ENVIRONMENT=development

# Optional search keys for the fact-check sidecar: each raises that provider's free limits, and Firecrawl runs only
# with one (docs/factcheck.md). Search works without them.
# PARALLEL_API_KEY=
# EXA_API_KEY=
# TAVILY_API_KEY=
# TINYFISH_API_KEY=
# FIRECRAWL_API_KEY=
