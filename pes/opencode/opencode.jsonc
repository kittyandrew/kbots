{
  "$schema": "https://opencode.ai/config.json",

  // No "model": kbots sets one on every session (tmodules/factcheck.py MODEL), because the config default drops
  // its #variant and silently falls back to any available model.
  "default_agent": "factcheck",

  // Appended to every agent's rules, built-ins included; last match wins, so this list decides. The sidecar
  // reads untrusted chat text, so nothing reaches files, shell, skills or subagents. `execute` runs code over
  // `download` only; the plugin shadows its unchecked fetch. `allow`, never `ask`: an ask blocks the turn.
  "permissions": [
    { "action": "*", "resource": "*", "effect": "deny" },
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "kbots_reply", "resource": "*", "effect": "allow" },
    { "action": "execute", "resource": "*", "effect": "allow" },
    { "action": "download", "resource": "*", "effect": "allow" }
  ],

  // Without a provider, websearch opens a consent form and the unattended turn blocks. "kbots" is the plugin's
  // keyless chain: Parallel, which returns the most article text, then Exa and Tavily when it fails.
  "websearch": { "provider": "kbots" },

  "snapshots": false // sessions sit in the server's cwd; from a git checkout (local runs, evals) every step snapshots it
}
